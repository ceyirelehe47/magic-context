{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["node", "bun"],
        "declaration": false,
        "declarationMap": false,
        "emitDeclarationOnly": false,
        "noEmit": true
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts", "types/**/*.d.ts"],
    "exclude": ["node_modules", "dist"]
}
